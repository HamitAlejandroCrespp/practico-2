#include <iostream>
using namespace std;
int main() {
    int n1, n2;
    cout << "Ingrese dos numeros: "; cin >> n1 >> n2;
    if (n1 > n2) {
        cout << "El numero mayor es: " << n1 << endl;
    } else if (n2 > n1) {
        cout << "El numero mayor es: " << n2 << endl;
    } else {
        cout << "Ambos son iguales" << endl;
    }
    return 0;
}
